# Public canonical URL
NEXT_PUBLIC_SITE_URL=https://yusuf-platform.vercel.app

# Neon PostgreSQL — set as a Vercel Production secret
DATABASE_URL=

# Neon Auth — set as Vercel Production secrets
NEON_AUTH_BASE_URL=https://YOUR-NEON-AUTH-HOST/neondb/auth
NEON_AUTH_COOKIE_SECRET=

# Browser-facing Neon Auth URL used by the official auth UI client
NEXT_PUBLIC_AUTH_URL=https://YOUR-NEON-AUTH-HOST/neondb/auth
# Backward-compatible alias accepted by this app
NEXT_PUBLIC_NEON_AUTH_URL=https://YOUR-NEON-AUTH-HOST/neondb/auth

# Optional external AI provider — keep empty to use deterministic fallback
AI_PROVIDER=deterministic
AI_API_KEY=
